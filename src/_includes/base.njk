<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DF6E4WWMBC"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-DF6E4WWMBC');
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="{{ site.name }} home">
        <img src="{{ site.logo }}" alt="{{ site.name }} logo" class="brand-logo">
        <span class="brand-text">
          <strong>{{ site.name }}</strong>
          <small>{{ site.tagline }}</small>
        </span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/menu/">Menu</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <img src="{{ site.logo }}" alt="" class="footer-logo">
        <p>{{ site.description }}</p>
      </div>
      <div>
        <h2>Find us</h2>
        <p>{{ site.address }}</p>
        <p style="margin-top: 0.25rem; margin-bottom: 0.75rem;"><a href="https://www.google.com/maps/search/?api=1&query=Glen+Roy+Cafe,+Roy+Bridge+PH31+4AE" target="_blank" rel="noopener noreferrer" style="color: var(--color-cream); text-decoration: underline;">Get Directions ↗</a></p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <div>
        <h2>Updates</h2>
        <p>Follow us on <a href="{{ site.facebook }}">Facebook</a> for opening updates, specials and local notices.</p>
      </div>
    </div>
  </footer>
</body>
</html>
